<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">
        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        >
        <title>{% block title %}Car-naval{% endblock %}</title>
        <link
            rel="stylesheet"
            href="/styles/app.css"
        >
        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>

    <body>
        <header class="site-header">
            <nav class="navigation">
                <a
                    class="brand"
                    href="{{ path('app_home') }}"
                >
                    <span class="brand-mark">C</span>

                    <span>
                        Car<span class="brand-accent">-</span>naval
                    </span>
                </a>

                <div class="navigation-links">
                    <a href="{{ path('app_home') }}">
                        Accueil
                    </a>

                    <a href="{{ path('app_ride_index') }}">
                        Trajets
                    </a>

                    {% if app.user %}
                        <span class="user-greeting">
                            Bonjour {{ app.user.firstName }}
                        </span>

                        <a
                            class="nav-cta"
                            href="{{ path('app_ride_new') }}"
                        >
                            Proposer un trajet
                        </a>

                        <a href="{{ path('app_ride_mine') }}">
                            Mes trajets
                        </a>

                        <a href="{{ path('app_booking_index') }}">
                            Mes réservations
                        </a>

                        <a href="{{ path('_logout_main') }}">
                            Déconnexion
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}">
                            Connexion
                        </a>

                        <a
                            class="nav-cta"
                            href="{{ path('app_register') }}"
                        >
                            Inscription
                        </a>
                    {% endif %}
                </div>
            </nav>
        </header>

        <div class="page-container">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
