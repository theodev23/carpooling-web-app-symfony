<!DOCTYPE html>
<html lang="fr">
    <head>
        <meta charset="UTF-8">

        <meta
            name="viewport"
            content="width=device-width, initial-scale=1"
        >

        <title>{% block title %}Car-naval{% endblock %}</title>

        <link
            rel="stylesheet"
            href="/styles/app.css"
        >

        {% block stylesheets %}{% endblock %}
        {% block javascripts %}{% endblock %}
    </head>

    <body>
        <header class="site-header">
            <nav class="navigation">
                <a
                    class="brand"
                    href="{{ path('app_home') }}"
                >
                    Car-naval
                </a>

                <div class="navigation-links">
                    <a href="{{ path('app_home') }}">
                        Accueil
                    </a>

                    <a href="{{ path('app_ride_index') }}">
                        Trajets
                    </a>

                    {% if app.user %}
                        <span>
                            Bonjour {{ app.user.firstName }}
                        </span>

                        <a href="{{ path('app_ride_new') }}">
                            Proposer un trajet
                        </a>

                        <a href="{{ path('_logout_main') }}">
                            Déconnexion
                        </a>
                    {% else %}
                        <a href="{{ path('app_login') }}">
                            Connexion
                        </a>

                        <a href="{{ path('app_register') }}">
                            Inscription
                        </a>
                    {% endif %}
                </div>
            </nav>
        </header>

        <div class="page-container">
            {% block body %}{% endblock %}
        </div>
    </body>
</html>
