{% extends 'base.html.twig' %}

{% block title %}Trajets disponibles - Car-naval{% endblock %}

{% block body %}
    <main>
        <h1>Trajets disponibles</h1>

        {% for message in app.flashes('success') %}
            <p>{{ message }}</p>
        {% endfor %}

        {% for message in app.flashes('error') %}
            <p>{{ message }}</p>
        {% endfor %}

        <form
            method="get"
            action="{{ path('app_ride_index') }}"
        >
            <div>
                <label for="departureCity">
                    Ville de départ
                </label>

                <input
                    type="text"
                    id="departureCity"
                    name="departureCity"
                    value="{{ departureCity }}"
                >
            </div>

            <div>
                <label for="arrivalCity">
                    Ville d'arrivée
                </label>

                <input
                    type="text"
                    id="arrivalCity"
                    name="arrivalCity"
                    value="{{ arrivalCity }}"
                >
            </div>

            <div>
                <label for="date">
                    Date
                </label>

                <input
                    type="date"
                    id="date"
                    name="date"
                    value="{{ date }}"
                >

                {% if dateError %}
                    <p>{{ dateError }}</p>
                {% endif %}
            </div>

            <button type="submit">
                Rechercher
            </button>

            <a href="{{ path('app_ride_index') }}">
                Réinitialiser
            </a>
        </form>

        {% if rides is empty %}
            <p>Aucun trajet disponible pour le moment.</p>
        {% else %}
            {% for ride in rides %}
                <article>
                    <h2>
                        {{ ride.departureCity }}
                        →
                        {{ ride.arrivalCity }}
                    </h2>

                    <p>
                        Départ :
                        {{ ride.departureAt|date('d/m/Y à H:i') }}
                    </p>

                    <p>
                        Places disponibles :
                        {{ ride.availableSeats }}
                    </p>

                    <p>
                        Prix :
                        {{ ride.price|number_format(2, ',', ' ') }}
                        € / passager
                    </p>

                    <p>
                        Conducteur :
                        {{ ride.driver.firstName }}
                        {{ ride.driver.lastName }}
                    </p>

                    {% if app.user %}
                        {% if app.user.id == ride.driver.id %}
                            <p>
                                Vous proposez ce trajet.
                            </p>
                        {% else %}
                            <form
                                method="post"
                                action="{{ path('app_ride_book', {id: ride.id}) }}"
                            >
                                <input
                                    type="hidden"
                                    name="_token"
                                    value="{{ csrf_token('book_ride_' ~ ride.id) }}"
                                >

                                <button type="submit">
                                    Réserver
                                </button>
                            </form>
                        {% endif %}
                    {% else %}
                        <p>
                            <a href="{{ path('app_login') }}">
                                Connectez-vous pour réserver
                            </a>
                        </p>
                    {% endif %}
                </article>
            {% endfor %}
        {% endif %}
    </main>
{% endblock %}
